{
  "buildCommand": "npm run build -w apps/api",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": "apps/api/.next",
  "crons": [
    {
      "path": "/api/health",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/audit-macro-drift",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/internal/feedback-digest",
      "schedule": "5 14 * * *"
    },
    {
      "path": "/api/internal/watch-review",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/internal/marketing/weekly",
      "schedule": "0 16 * * 2"
    }
  ]
}
