{
  "name": "@fitsy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --schema ../../prisma/schema.prisma && next build",
    "start": "next start",
    "pretest": "prisma generate --schema ../../prisma/schema.prisma",
    "test": "jest",
    "pretest:coverage": "npm run pretest",
    "pretest:coverage:gc": "npm run pretest",
    "test:rate-limits": "bash ../../scripts/verify/rate-limit-store.sh",
    "test:coverage": "jest --coverage",
    "test:coverage:gc": "node --expose-gc ../../node_modules/jest/bin/jest.js --coverage",
    "type-check": "prisma generate --schema ../../prisma/schema.prisma && tsc --noEmit",
    "lint": "eslint --no-warn-ignored ."
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.100.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "next": "^15.0.0",
    "obscenity": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jest": "^29.7.0",
    "prisma": "^6.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0"
  }
}
