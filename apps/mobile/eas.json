{
  "cli": {
    "version": ">= 18.0.0"
  },
  "build": {
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {}
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "CONFIGURE_IN_EAS_DASHBOARD",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "CONFIGURE_IN_EAS_DASHBOARD"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "CONFIGURE_IN_EAS_DASHBOARD",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "CONFIGURE_IN_EAS_DASHBOARD"
      }
    }
  }
}
