#!/bin/bash -p
# Run the same local gate, reusing only successful source-bound acceptance receipts.
# Size and domain checks still run on every push.
set -euo pipefail
unset NODE_OPTIONS NODE_PATH BASH_ENV ENV
hook_path="$PATH"
export PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
# The canonical hook lives in a direct child of its reviewed checkout.
# Caller Git worktree selectors cannot choose the verification source.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$ROOT"
# Git exports repository-local pointers into hooks. Child Git fixtures must
# resolve their own repositories rather than the outer push checkout.
while IFS= read -r name; do
  unset "$name"
done < <(git rev-parse --local-env-vars)
[ "$(git rev-parse --show-toplevel)" = "$ROOT" ] || exit 1
# Apple's Git launcher prepends its private executables and supplies default
# Xcode paths to hooks. Restore the ordinary shell environment before running
# the same local verification; keep caller-supplied nondefault values bound.
git_core="${hook_path%%:*}"
if [[ "$git_core" == */usr/libexec/git-core ]]; then
  developer_dir="${git_core%/usr/libexec/git-core}"
  if [[ "${CPATH-}" == /usr/local/include ]]; then unset CPATH
  elif [[ "${CPATH-}" == *:/usr/local/include ]]; then export CPATH="${CPATH%:/usr/local/include}"
  fi
  if [[ "${LIBRARY_PATH-}" == /usr/local/lib ]]; then unset LIBRARY_PATH
  elif [[ "${LIBRARY_PATH-}" == *:/usr/local/lib ]]; then export LIBRARY_PATH="${LIBRARY_PATH%:/usr/local/lib}"
  fi
  if [[ "${SDKROOT-}" == "$developer_dir/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk" ]]; then unset SDKROOT; fi
  default_manpath="$developer_dir/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk/usr/share/man:$developer_dir/Platforms/MacOSX.platform/usr/share/man:$developer_dir/usr/share/man:$developer_dir/Toolchains/XcodeDefault.xctoolchain/usr/share/man:"
  if [[ "${MANPATH-}" == "$default_manpath" ]]; then unset MANPATH
  elif [[ "${MANPATH-}" == "$default_manpath"* ]]; then export MANPATH="${MANPATH#"$default_manpath"}"
  fi
fi
# Privileged Bash ignores exported functions but retains their environment
# entries for ordinary child shells. Remove them before any verification child.
function_environment=()
while IFS= read -r -d '' name; do
  function_environment+=(-u "$name")
done < <(node -e 'for (const key of Object.keys(process.env)) if (key.startsWith("BASH_FUNC_")) process.stdout.write(key + "\0")')
if [ "${#function_environment[@]}" -gt 0 ]; then
  exec /usr/bin/env "${function_environment[@]}" /bin/bash -p "$0" "$@"
fi
# A push must name the issue whose local evidence this hook is about to run.
node "$ROOT/scripts/delivery/phase-events.mjs" summary >/dev/null || {
  echo 'pre-push: bind this worktree first with node scripts/delivery/phase-events.mjs bind --issue N' >&2
  exit 1
}
"$ROOT/scripts/verify/run.mjs" --layer=0-3 --runs=local --reuse
# exit 2 = skipped (not applicable), which must not block the push
for check in size-check domain-check; do
  if /bin/bash -p "$ROOT/scripts/verify/$check.sh"; then code=0; else code=$?; fi
  if [ "$code" -ne 0 ] && [ "$code" -ne 2 ]; then
    echo "pre-push: $check failed (see above)" >&2
    exit 1
  fi
done
# Publishing is recoverable; a GitHub outage must not erase a verified push.
if ! node "$ROOT/scripts/delivery/phase-events.mjs" publish; then
  echo 'pre-push: delivery timing remains local; retry phase-events.mjs publish after reconciling GitHub' >&2
fi
