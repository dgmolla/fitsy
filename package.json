{
  "name": "fitsy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts"
  ],
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:mobile": "npm run start -w apps/mobile",
    "build:api": "npm run build -w apps/api",
    "build": "npm run build -w apps/api",
    "start:api": "npm run start -w apps/api",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev:env": "bash scripts/dev/write-local-env.sh",
    "dev:reset": "tsx scripts/dev/reset.ts",
    "dev:snapshot": "tsx scripts/dev/snapshot.ts",
    "audit:menu-identity": "node --import tsx scripts/menu-source-collisions.ts",
    "audit:chain-coverage": "node --import tsx scripts/chain-coverage-audit.ts",
    "preload:v2:dev": "node --import tsx scripts/preload-v2.ts",
    "perf:check": "bash scripts/verify/performance.sh",
    "perf:bundle": "node scripts/perf/bundle.mjs --build",
    "perf:api": "node scripts/perf/api.mjs",
    "perf:db": "tsx --tsconfig apps/api/tsconfig.json apps/api/tests/performance/database.ts",
    "eval:chain-match": "node --import tsx scripts/eval/run-eval.ts --decision=chain-match",
    "eval:pdf-finder": "node --import tsx scripts/eval/pdf-finder/run.ts",
    "verify": "node scripts/verify/run.mjs --layer=0-2 --scope=changed",
    "verify:all": "node scripts/verify/run.mjs --layer=all --scope=all",
    "verify:dev-drift": "bash scripts/verify/dev-drift.sh",
    "verify:sim-plan": "node scripts/verify/impact-plan.mjs --simulator",
    "verify:product-plan": "node scripts/verify/product-flow.mjs --plan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "verify:dependencies": "node scripts/verify/dependency-audit.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@axiomhq/js": "^1.6.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@t3-oss/env-core": "^0.13.11",
    "expo": "~54.0.33",
    "expo-linear-gradient": "~15.0.8",
    "h3-js": "^4.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "dependency-cruiser": "^16.10.4",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tsx": "^4.21.0"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
