{
  "name": "@fitsy/scripts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "jest",
    "type-check": "tsc --noEmit",
    "lint": "npm run lint:jev-macro",
    "eval:jev-macro": "node --import tsx eval/jev-macro/run.ts",
    "eval:jev-macro:truth": "node --import tsx eval/jev-macro/build-truth.ts",
    "lint:jev-macro": "eslint --config eval/jev-macro/eslint.config.mjs eval/jev-macro"
  },
  "dependencies": {
    "@fitsy/shared": "*"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.0.0"
  }
}
