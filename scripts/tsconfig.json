{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@fitsy/shared": ["../packages/shared/src/index.ts"],
      "@fitsy/shared/*": ["../packages/shared/src/*"]
    },
    "outDir": ".tsbuild"
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules", ".tsbuild", "**/*.test.ts"]
}
