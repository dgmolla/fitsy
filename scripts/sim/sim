#!/usr/bin/env bash
# Simulator CLI for agents (autoship L7): one wrapper per verb, JSON-friendly,
# evidence lands in .evidence/ by default. Thin layer over xcrun simctl + expo.
#
#   scripts/sim/sim boot [--device "iPhone 16"]     boot (or reuse) a simulator
#   scripts/sim/sim install <path.app>              install an app bundle
#   scripts/sim/sim launch <bundle-id|--url URL>    launch app or open deep link
#   scripts/sim/sim screenshot <name>               PNG -> .evidence/sim/<name>.png
#   scripts/sim/sim logs [--grep RE] [--seconds N]  device log excerpt to stdout
#   scripts/sim/sim reset                           erase the booted simulator
#   scripts/sim/sim status                          booted device + claim, JSON line
#   FITSY_SIM_OWNER=me scripts/sim/sim claim [--minutes N]   sign out (default 30m)
#   FITSY_SIM_OWNER=me scripts/sim/sim release               give it back
# Identity is ALWAYS the FITSY_SIM_OWNER env var, for claim and destructive
# verbs alike - one source, so you cannot lock yourself out.
set -euo pipefail
REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
EVID="$REPO_ROOT/.evidence/sim"; mkdir -p "$EVID"
CMD="${1:-status}"; shift || true

# grep exits 1 on no booted device; do not let set -e kill the script for that
booted_udid() { xcrun simctl list devices booted | grep -oE '[0-9A-F-]{36}' | head -1 || true; }

# ── Claim sheet ─────────────────────────────────────────────────────────────
# Multiple agents share one Mac; destructive verbs (boot/install/launch/reset)
# respect an active claim by someone else. Claims expire on their own so a
# dead agent never wedges the sim. Claim acquisition is check-then-write, not
# atomic: cooperating agents on one machine, worst case equals the no-sheet
# world - accepted tradeoff.
CLAIM_FILE="$HOME/.fitsy-sim-claim.json"
claim_owner() { # prints active owner, or nothing
  [ -f "$CLAIM_FILE" ] || return 0
  python3 - "$CLAIM_FILE" <<'PY'
import json, sys, time
try:
    d = json.load(open(sys.argv[1]))
    if d.get("expires", 0) > time.time():
        print(d.get("owner", ""))
except Exception:
    pass
PY
}
require_claim_or_free() { # identity from FITSY_SIM_OWNER (defaults to "anonymous", which any claim blocks)
  local me="${FITSY_SIM_OWNER:-anonymous}"
  local owner; owner="$(claim_owner)"
  if [ -n "$owner" ] && [ "$owner" != "$me" ]; then
    printf '{"name":"sim-%s","status":"fail","summary":"simulator is claimed by %s","fix":"wait for the claim to expire (sim status shows it), coordinate, or claim it yourself once free: sim claim <you>"}
' "$CMD" "$owner"
    exit 1
  fi
}

case "$CMD" in
  claim)
    ME="${FITSY_SIM_OWNER:?export FITSY_SIM_OWNER=<agent-name> first}"
    MIN=30; [ "${1:-}" = "--minutes" ] && MIN="${2:-30}"
    case "$MIN" in ''|*[!0-9]*)
      printf '{"name":"sim-claim","status":"fail","summary":"--minutes must be a positive integer","fix":"sim claim --minutes 30"}
'; exit 1;; esac
    OWNER="$(claim_owner)"
    if [ -n "$OWNER" ] && [ "$OWNER" != "$ME" ]; then
      printf '{"name":"sim-claim","status":"fail","summary":"already claimed by %s","fix":"sim status shows the expiry; coordinate or wait"}
' "$OWNER"
      exit 1
    fi
    python3 - "$CLAIM_FILE" "$ME" "$MIN" <<'PY'
import json, sys, time
json.dump({"owner": sys.argv[2], "expires": time.time() + int(sys.argv[3]) * 60,
           "claimed_at": time.strftime("%FT%TZ", time.gmtime())}, open(sys.argv[1], "w"))
PY
    printf '{"name":"sim-claim","status":"pass","owner":"%s","minutes":%s}
' "$ME" "$MIN"
    ;;
  release)
    ME="${FITSY_SIM_OWNER:?export FITSY_SIM_OWNER=<agent-name> first}"
    OWNER="$(claim_owner)"
    if [ -n "$OWNER" ] && [ "$OWNER" != "$ME" ]; then
      printf '{"name":"sim-release","status":"fail","summary":"claimed by %s, not you","fix":"only the claim owner releases it"}
' "$OWNER"
      exit 1
    fi
    rm -f "$CLAIM_FILE"
    printf '{"name":"sim-release","status":"pass","owner":"%s"}
' "$ME"
    ;;
  boot)
    require_claim_or_free
    DEVICE="iPhone 16"
    [ "${1:-}" = "--device" ] && DEVICE="$2"
    UDID="$(booted_udid)"
    if [ -z "$UDID" ]; then
      UDID="$(xcrun simctl list devices available | grep -F "$DEVICE (" | grep -oE '[0-9A-F-]{36}' | head -1)"
      [ -n "$UDID" ] || { echo "no available simulator named '$DEVICE'" >&2; exit 1; }
      xcrun simctl boot "$UDID"
      open -a Simulator --background || true
    fi
    printf '{"name":"sim-boot","status":"pass","udid":"%s"}\n' "$UDID"
    ;;
  install)
    require_claim_or_free
    APP="${1:?path to .app}"
    xcrun simctl install booted "$APP"
    printf '{"name":"sim-install","status":"pass","app":"%s"}\n' "$APP"
    ;;
  launch)
    require_claim_or_free
    if [ "${1:-}" = "--url" ]; then
      xcrun simctl openurl booted "$2"
      printf '{"name":"sim-launch","status":"pass","url":"%s"}\n' "$2"
    else
      xcrun simctl launch booted "${1:?bundle id}" >/dev/null
      printf '{"name":"sim-launch","status":"pass","bundle":"%s"}\n' "$1"
    fi
    ;;
  screenshot)
    NAME="${1:?screenshot name}"
    OUT="$EVID/$NAME.png"
    xcrun simctl io booted screenshot "$OUT" >/dev/null
    printf '{"name":"sim-screenshot","status":"pass","file":"%s"}\n' "${OUT#$REPO_ROOT/}"
    ;;
  logs)
    GREP=""; SECS=30
    while [ $# -gt 0 ]; do case "$1" in --grep) GREP="$2"; shift 2;; --seconds) SECS="$2"; shift 2;; *) shift;; esac; done
    if [ -n "$GREP" ]; then
      xcrun simctl spawn booted log show --last "${SECS}s" --style compact 2>/dev/null | grep -E "$GREP" | tail -100
    else
      xcrun simctl spawn booted log show --last "${SECS}s" --style compact 2>/dev/null | tail -100
    fi
    ;;
  reset)
    require_claim_or_free
    UDID="$(booted_udid)"; [ -n "$UDID" ] || { echo "nothing booted" >&2; exit 1; }
    xcrun simctl shutdown "$UDID" && xcrun simctl erase "$UDID"
    printf '{"name":"sim-reset","status":"pass","udid":"%s"}\n' "$UDID"
    ;;
  status)
    UDID="$(booted_udid)"
    OWNER="$(claim_owner)"
    if [ -n "$UDID" ]; then
      NAME="$(xcrun simctl list devices booted | grep "$UDID" | sed -E 's/^ +([^(]+) \(.*/\1/' | head -1 | xargs)"
      printf '{"name":"sim-status","status":"pass","booted":true,"udid":"%s","device":"%s","claimed_by":"%s"}\n' "$UDID" "$NAME" "${OWNER:-}"
    else
      printf '{"name":"sim-status","status":"pass","booted":false,"claimed_by":"%s"}\n' "${OWNER:-}"
    fi
    ;;
  *) echo "unknown subcommand: $CMD" >&2; exit 1 ;;
esac
