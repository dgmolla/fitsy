-export LC_ALL=C
 REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
 NAME="dev-drift"
 
@@ -33,13 +31,9 @@ fi
 Q() { psql "$URL" -Atqc "$1"; }
 
 # 1. Migrations applied in dev vs migrations on disk.
-if ! applied="$(Q "select migration_name from _prisma_migrations where finished_at is not null")"; then
