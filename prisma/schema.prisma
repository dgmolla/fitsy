// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

model User {
  id              String        @id  // UUID provided by Supabase auth.users.id
  email           String        @unique
  name            String?
  birthday        DateTime?
  heightCm        Float?
  weightKg        Float?
  activityLevel   String?
  goal            String?
  onboardingStep  Int           @default(0)
  pushToken       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  macroTarget     MacroTarget?
  savedItems      SavedItem[]
  subscription    Subscription?
}

model MacroTarget {
  id        String   @id @default(cuid())
  userId    String   @unique
  calories  Int
  proteinG  Float
  carbsG    Float
  fatG      Float
  goalType  GoalType @default(maintain)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Restaurant {
  id              String      @id @default(cuid())
  storeUuid       String      @unique
  homeHex         String?
  brand           String?
  name            String
  address         String
  lat             Float
  lng             Float
  cuisineTags     String[]
  chainFlag       Boolean     @default(false)
  source          String
  menuSourceId    String?
  photoUrl        String?
  photoSource     String?
  rating          Float?
  userRatingCount Int?
  priceLevel      String?
  dietaryOptions  String[]    @default([])
  lastScrapedAt   DateTime?
  menuHash        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  menuItems       MenuItem[]
  savedItems      SavedItem[]

  @@index([lat, lng])
  @@index([homeHex])
}

model MenuItem {
  id             String          @id @default(cuid())
  restaurantId   String
  name           String
  description    String?
  photoUrl       String?
  category       String?
  section        String?
  price          Float?
  dietaryTags    String[]        @default([])
  // Denormalized macro snapshot from MacroEstimate. Read path queries
  // these columns directly to avoid joining MacroEstimate per request.
  // MacroEstimate remains the audit log (confidence, reasoning, etc.).
  // Kept in sync via dual-write in scripts/pipeline-utils.ts and a daily
  // drift audit cron at /api/internal/audit-macro-drift.
  calories       Int?
  proteinG       Float?
  carbsG         Float?
  fatG           Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  macroEstimates MacroEstimate[]
  savedItems     SavedItem[]

  @@unique([restaurantId, name])
  @@index([restaurantId])
}

model MacroEstimate {
  id                   String          @id @default(cuid())
  menuItemId           String          @unique
  calories             Int
  proteinG             Float
  carbsG               Float
  fatG                 Float
  confidence           ConfidenceLevel
  source               String?
  hadPhoto             Boolean         @default(false)
  ingredientBreakdown  Json?
  reasoning            String?
  estimatedAt          DateTime        @default(now())
  expiresAt            DateTime?
  menuItem             MenuItem        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model SavedItem {
  id           String        @id @default(cuid())
  userId       String
  restaurantId String?
  menuItemId   String?
  itemType     SavedItemType
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?   @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
  menuItem     MenuItem?     @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@unique([userId, menuItemId])
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String
  status               String
  appleTransactionId   String?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PipelineCompletedHex {
  id        String   @id @default(cuid())
  runId     String
  hexId     String
  count     Int      // restaurants persisted in this hex
  createdAt DateTime @default(now())

  @@unique([runId, hexId])
  @@index([runId])
}

enum GoalType {
  cut
  bulk
  maintain
  custom
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

enum SavedItemType {
  restaurant
  menu_item
}
