# Database (from Supabase via Vercel integration)
POSTGRES_PRISMA_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/postgres

# Supabase Auth (Settings → API in your Supabase project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# External APIs
GOOGLE_PLACES_API_KEY=your-key-here
FIRECRAWL_API_KEY=your-key-here
ANTHROPIC_API_KEY=your-key-here

# UberEats unauth feed probe.
# URL-encoded JSON captured from a browser session: open ubereats.com (logged
# out is fine), pick any delivery address, then DevTools → Application →
# Cookies → uev2.loc → copy the raw value. The pipeline overrides
# latitude/longitude per-probe; other fields (HERE reference, address) are
# cosmetic. Rotate if pipeline logs show repeated empty-state responses.
UE_LOC_COOKIE=%7B%22address%22%3A%7B...%7D%2C%22latitude%22%3A34.05%2C%22longitude%22%3A-118.25%2C...%7D

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mobile
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
